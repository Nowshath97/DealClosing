# OpenAI API key used by the local Ask AI server. Keep the real key in ask-ai.local.env;
# never put it in the browser .env file.
OPENAI_API_KEY=

# Optional provider/model overrides. Defaults to OpenAI when OPENAI_API_KEY is set.
# ASK_AI_PROVIDER=openai
# ASK_AI_MODEL=gpt-6-luna
# ASK_AI_PORT=8787